# --- Server ---
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
# Comma-separated list of origins allowed to hit /api/*
CORS_ORIGINS=http://localhost:5173

# --- Supabase ---
# https://supabase.com -> your project -> Settings -> API
SUPABASE_URL=
# MUST be the **service_role** secret (long JWT, usually starts with eyJ...).
# Do NOT use the anon or "publishable" key here — RLS will block inserts and
# the ingest script will fail with "violates row-level security policy".
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Gemini (embeddings) ---
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_EMBED_DIM=768

# --- Groq (LLM) ---
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant

# --- ElevenLabs (TTS) ---
# https://elevenlabs.io -> Profile -> API Keys (rotate the previously leaked key!)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# --- Clerk (auth) ---
# https://dashboard.clerk.com -> your app -> API Keys
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# --- RAG tuning ---
RAG_TOP_K=5
RAG_CANDIDATES=20
RAG_SCORE_THRESHOLD=0.55
RAG_USE_RERANKER=true
RAG_USE_HYBRID=true
RAG_USE_QUERY_REWRITE=true

# --- Web Search (DuckDuckGo, no API key required) ---
WEB_SEARCH_ENABLED=true
WEB_SEARCH_QUERY_PLANNER=true
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT_MS=8000
